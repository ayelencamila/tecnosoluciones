APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=65080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# To avoid warnings:
MYSQL_EXTRA_OPTIONS=
FORWARD_DB_PORT=65001
PHPMYADMIN_PORT=65081

# Registro público de usuarios. Apagado: en un sistema multi-empresa el alta
# de usuarios la hace el administrador de cada empresa desde /admin/usuarios.
# Encender solo para demostraciones (ver config/auth.php).
REGISTRO_PUBLICO_HABILITADO=false

# --- Respaldos (spatie/laravel-backup) ---
# Disco destino. 'local' sirve para desarrollo, pero un respaldo en el mismo
# disco que la base NO es un respaldo: en produccion apuntar a 's3' u otro
# disco remoto.
BACKUP_DISK=local
# Contrasena de cifrado del archivo. El respaldo contiene todos los datos
# personales en texto plano, asi que en produccion esto NO puede quedar vacio.
# Guardala fuera del servidor: sin ella el respaldo no se puede restaurar.
BACKUP_ARCHIVE_PASSWORD=

# --- Textos legales ---
# Mientras este en false, /legal/privacidad y /legal/terminos muestran una
# franja que las declara BORRADOR. Poner en true SOLO cuando el texto legal
# haya sido redactado y revisado.
LEGAL_TEXTOS_DEFINITIVOS=false
LEGAL_ACTUALIZADO=2026-10-31
LEGAL_RAZON_SOCIAL="TecnoSoluciones SRL"
LEGAL_CUIT=30-00000000-0
LEGAL_DOMICILIO="San Martín 465, San Javier, Misiones, Argentina"
LEGAL_EMAIL_CONTACTO=contacto@ejemplo.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=65037
FORWARD_REDIS_PORT=65037

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=65252
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@ejemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=65173